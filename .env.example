# Copy to .env and fill in your real key.
# GEMINI_API_KEY: Google AI Studio API key. When it is missing or still the
#   placeholder below, LegalEase logs a warning and uses the built-in offline
#   composer, so the app stays fully functional without network access.
GEMINI_API_KEY=your_actual_gemini_api_key_here

# FastAPI server bind settings.
HOST=0.0.0.0
PORT=8000

# URL the Streamlit frontend uses to reach the FastAPI backend.
# Defaults to http://127.0.0.1:8000 when unset.
# API_BASE_URL=http://127.0.0.1:8000

# Gemini model id used for document generation.
# GEMINI_MODEL=gemini-1.5-pro

# Set to 0 to disable the offline fallback and force hard failures on Gemini errors.
# ALLOW_OFFLINE_FALLBACK=1
